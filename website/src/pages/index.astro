---
// The home page (design/BRIEF.md): static HTML and CSS, one small script for
// the theme and the chart's entrance. Its samples are getting started's, its
// numbers the published benchmark's, its doc sets the manifest's, its
// version crates.io's.
import { Box, FileCode, MonitorSmartphone, SquareTerminal, Gauge, ArrowRight, ArrowUpRight } from 'lucide-react';
import Base from '@/layouts/Base.astro';
import BenchOverview from '@/components/home/BenchOverview.astro';
import CodeBlocks from '@/components/CodeBlocks.astro';
import readme from '@/generated/readme.json';
import { sets } from '../../docs.manifest.mjs';
import { headline, date, commit, repo, fmt, scene, value } from '@/lib/perf';
import { repoUrl } from '@/lib/shared';
import { publishedVersion, workspaceVersion } from '@/lib/repo';
import { codeBlock } from '@/lib/highlight';
import fs from 'node:fs';
import path from 'node:path';

const published = await publishedVersion();
const version = published ?? workspaceVersion();
const icons = { Box, FileCode, MonitorSmartphone, SquareTerminal, Gauge } as const;
const h = headline();
const heavy = scene('heavy');

const rust = codeBlock({ code: readme.samples.rust, lang: 'rust', title: 'counter.rs' });
const luau = codeBlock({ code: readme.samples.luau, lang: 'luau', title: 'app.luau' });
const install = codeBlock({ code: 'cargo add zgx zgx-desktop', lang: 'sh', title: 'Rust' });
const installLuau = codeBlock({ code: 'cargo install zgx-run', lang: 'sh', title: 'Luau' });
const agentCode = codeBlock({
  code: `claude mcp add zgx -- zgx inspect mcp   # or any MCP client\nzgx inspect tree --depth 2\nzgx inspect click '"Send"'\nzgx inspect frames 5`,
  lang: 'sh',
  title: 'terminal',
});

// A hand-written page's title, from its frontmatter.
function mdxTitle(p: { mdx?: string }) {
  if (!p.mdx) return undefined;
  const text = fs.readFileSync(path.join(process.cwd(), 'content-src', p.mdx), 'utf8');
  return text.match(/^title:\s*(.+)$/m)?.[1].replace(/^["']|["']$/g, '');
}
// Each doc set's first pages after its overview, as quick links.
const quick = (set: (typeof sets)[number]) =>
  set.pages
    .filter((p): p is Exclude<typeof p, string> => typeof p !== 'string' && p.slug !== 'index')
    .slice(0, 3)
    .map((p) => ({ href: `/${set.dir}/${p.slug}`, title: ('title' in p && p.title) || mdxTitle(p) || p.slug }));
// README's features read on from their bold lead: alone, each starts a sentence.
const sentence = (html: string) => {
  const s = html.replace(/^\(([^)]*)\):\s*/, '$1: ');
  return /^[a-z]/.test(s) ? s[0].toUpperCase() + s.slice(1) : s;
};
const stats = [
  { value: `${fmt(value(heavy, 'zgx', 'idle', 'cpu_percent_one_core')!, 2)}%`, label: 'CPU while idle', note: 'An idle window does no work.' },
  { value: h.cards[2].value, label: 'Frames over 25 ms', note: 'In every mode of every scene.' },
  { value: h.cards[0].value, label: 'CPU, heavy dashboard', note: h.cards[0].detail.map((d) => `${d.name} ${d.text}`).join(' · ') },
];
const words = 'Native interfaces that do'.split(' ');
---

<Base title="zgx: native interfaces in Rust and Luau" description={readme.lede} image="/og/index.png" bare>
  <a href="#main" class="skip">Skip to content</a>
  <header class="top">
    <div class="wrap top-row">
      <a href="/" class="brand" aria-label="zgx home">
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="6" fill="var(--color-signal)"></rect>
          <path d="M7.5 8h9l-9 8h9" fill="none" stroke="var(--color-paper)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="brand-name">zgx</span>
      </a>
      <nav aria-label="Documentation" class="top-nav">
        {sets.map((set) => <a href={`/${set.dir}`}>{set.dir === 'rust' ? 'Rust' : set.dir === 'luau' ? 'Luau' : set.title}</a>)}
      </nav>
      <div class="top-actions">
        <a href="#docs" class="top-docs">Docs</a>
        <a href={repoUrl} class="icon-btn" aria-label="zgx on GitHub">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2 0 1.9 1.2 1.9 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8 0 3.2.9.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1.1.9 2.2v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3"></path></svg>
        </a>
        <button type="button" class="icon-btn" id="theme-toggle" aria-label="Switch to dark theme">
          <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
          <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap">
        <a class="pill rise" href="/rust/changelog" style="--i: 0">
          <span class="pill-dot" aria-hidden="true"></span>
          {published ? `${version} on crates.io` : `zgx ${version}`}
          <span class="pill-muted">What’s new <ArrowRight size={12} aria-hidden="true" /></span>
        </a>
        <h1 id="hero-title">
          {words.map((w, i) => <span class="rise" style={`--i: ${i + 1}`}>{w}&nbsp;</span>)}
          <em class="rise" style={`--i: ${words.length + 1}`}>no work</em>{' '}
          <span class="rise" style={`--i: ${words.length + 2}`}>when nothing changes.</span>
        </h1>
        <div class="hero-foot rise" style={`--i: ${words.length + 3}`}>
          <p class="lede">
            A retained-mode GUI framework for macOS, Windows and Linux. Components mount once, signals repaint only what reads them, and an idle window sleeps. Write it in Rust, or in Luau that hot reloads.
          </p>
          <div class="cta">
            <a class="btn btn-primary" href="/rust/getting-started">Start in Rust <ArrowRight size={16} aria-hidden="true" /></a>
            <a class="btn" href="/luau/getting-started">Start in Luau</a>
          </div>
        </div>
      </div>
    </section>

    <section class="pair" aria-labelledby="pair-title">
      <div class="wrap">
        <div class="pair-head">
          <p class="eyebrow">01 · One interface, two ways to write it</p>
          <h2 id="pair-title">A counter in Rust,<br /><em>and the same one in Luau.</em></h2>
        </div>
        <div class="pair-grid">
          <figure class="pair-item">
            <Fragment set:html={rust} />
            <figcaption><strong>Rust.</strong> A component with state of its own; <code>text_signal</code> follows the count, and nothing else repaints.</figcaption>
          </figure>
          <figure class="pair-item">
            <Fragment set:html={luau} />
            <figcaption><strong>Luau.</strong> Built once and lowered to the same views. Save the file and the window updates, its count kept.</figcaption>
            <div class="install">
              <p class="install-label">Install</p>
              <div class="install-grid">
                <Fragment set:html={install} />
                <Fragment set:html={installLuau} />
              </div>
            </div>
          </figure>
        </div>
      </div>
    </section>

    <section class="bench" aria-labelledby="bench-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">02 · Measured, {date}</p>
            <h2 id="bench-title">The least CPU in <em>{h.ledCpu} of {h.tests}</em> tests.</h2>
          </div>
          <p>
            Against GPUI Fast, MyGo and Rune: the same four scenes, built from one workload, run on one Mac in one session. Each mark is a rival’s figure as a multiple of zgx’s; right of the green line, it uses more.
          </p>
        </div>
        <BenchOverview />
        <dl class="stats">
          {
            stats.map((s) => (
              <div class="stat">
                <dt>{s.label}</dt>
                <dd class="stat-value">{s.value}</dd>
                <dd class="stat-note">{s.note}</dd>
              </div>
            ))
          }
        </dl>
        <p class="bench-foot">
          <span>Apple M5 Max, macOS 26. Medians of fresh launches; zgx at <a href={`${repo}/commit/${commit}`}><code>{commit.slice(0, 7)}</code></a>.</span>
          <a class="more" href="/performance">Every scene and metric <ArrowRight size={14} aria-hidden="true" /></a>
        </p>
      </div>
    </section>

    <section class="docs" id="docs" aria-labelledby="docs-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">03 · Documentation</p>
            <h2 id="docs-title">Five ways in.</h2>
          </div>
          <p>Each set has its own sidebar, and every page is the repository’s own docs, rebuilt whenever they change.</p>
        </div>
        <ul class="sets">
          {
            sets.map((set, i) => {
              const Icon = icons[set.icon as keyof typeof icons];
              return (
                <li class="set">
                  <a href={`/${set.dir}`} class="set-main">
                    <span class="set-top">
                      <span class="set-icon" aria-hidden="true">
                        <Icon size={18} strokeWidth={1.7} />
                      </span>
                      <span class="set-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                    </span>
                    <span class="set-title">{set.title}</span>
                    <span class="set-desc">{set.description}</span>
                  </a>
                  <ul class="set-links" aria-label={`${set.title}: start here`}>
                    {quick(set).map((q) => (
                      <li>
                        <a href={q.href}>
                          {q.title}
                          <ArrowUpRight size={12} aria-hidden="true" />
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>

    <section class="features" aria-labelledby="features-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">04 · What it has</p>
            <h2 id="features-title">Everything a desktop app reaches for.</h2>
          </div>
        </div>
        <ul class="feature-grid">
          {
            readme.features.map((f) => (
              <li>
                <h3>{f.title}</h3>
                <p set:html={sentence(f.html)} />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="agents" aria-labelledby="agents-title">
      <div class="wrap agents-grid">
        <div>
          <p class="eyebrow">05 · Devtools</p>
          <h2 id="agents-title">Built to be driven <em>by agents.</em></h2>
          <p class="agents-text">
            <code>zgx inspect</code> reads a running app’s tree, state, errors and frame costs, and clicks, types and presses keys by the same targets its tests use. Served over MCP, any agent can drive it.
          </p>
          <a class="more" href="/devtools">Devtools <ArrowRight size={14} aria-hidden="true" /></a>
        </div>
        <Fragment set:html={agentCode} />
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap">
      <div class="foot-grid">
        <div class="foot-brand">
          <span class="foot-mark">zgx</span>
          <p>Native interfaces in Rust and Luau. MIT licensed.</p>
        </div>
        <nav aria-label="Documentation" class="foot-col">
          <p class="foot-head">Docs</p>
          {sets.map((set) => <a href={`/${set.dir}`}>{set.title}</a>)}
        </nav>
        <nav aria-label="Project" class="foot-col">
          <p class="foot-head">Project</p>
          <a href={repoUrl}>GitHub</a>
          <a href="/rust/changelog">Changelog</a>
          <a href="https://crates.io/crates/zgx">crates.io</a>
          <a href="/llms.txt">llms.txt</a>
        </nav>
      </div>
      <p class="foot-base">Every page is built from the repository’s own docs and benchmark data.</p>
    </div>
  </footer>
  <CodeBlocks />
</Base>

<script is:inline>
  (() => {
    const button = document.getElementById('theme-toggle');
    const sync = () => {
      const dark = document.documentElement.classList.contains('dark');
      button.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
    };
    sync();
    button.addEventListener('click', () => {
      const dark = !document.documentElement.classList.contains('dark');
      document.documentElement.classList.toggle('dark', dark);
      document.documentElement.classList.toggle('light', !dark);
      document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
      sync();
    });
  })();
</script>

<style>
  .wrap {
    width: 100%;
    max-width: 78rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2.75rem);
  }
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 3px;
    border-radius: 0.4rem;
  }
  em {
    font-style: italic;
    color: var(--color-signal);
  }
  .eyebrow {
    margin: 0 0 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-fd-muted-foreground);
  }
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 3.75rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.9375rem;
    font-weight: 550;
    color: var(--color-ink);
    transition: color 150ms ease-out, gap 150ms ease-out;
  }
  .more:hover {
    gap: 0.5rem;
    color: var(--color-signal);
  }
  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 1.25rem 4rem;
    align-items: end;
    margin-bottom: 3rem;
  }
  .section-head > p {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-fd-muted-foreground);
    text-wrap: pretty;
  }
  @media (max-width: 880px) {
    .section-head {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---- Header ---- */
  .top {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in oklab, var(--color-paper) 80%, transparent);
    backdrop-filter: saturate(1.3) blur(16px);
    border-bottom: 1px solid var(--color-hairline);
  }
  .top-row {
    display: flex;
    align-items: center;
    gap: 2.25rem;
    height: 3.75rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .brand-name {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.75rem;
    line-height: 1;
    letter-spacing: -0.01em;
    transform: translateY(-1px);
  }
  .top-nav {
    display: flex;
    gap: 1.75rem;
    font-size: 0.875rem;
    color: var(--color-fd-muted-foreground);
  }
  .top-nav a {
    transition: color 150ms ease-out;
  }
  .top-nav a:hover,
  .top-docs:hover {
    color: var(--color-ink);
  }
  .top-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
  }
  .top-docs {
    display: none;
    padding: 0 0.6rem;
    font-size: 0.875rem;
    font-weight: 550;
    color: var(--color-fd-muted-foreground);
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.55rem;
    color: var(--color-fd-muted-foreground);
    transition: color 150ms ease-out, background-color 150ms ease-out;
  }
  .icon-btn:hover {
    color: var(--color-ink);
    background: color-mix(in oklab, var(--color-ink) 6%, transparent);
  }
  :global(.dark) .sun,
  :global(html:not(.dark)) .moon {
    display: none;
  }
  @media (max-width: 820px) {
    .top-nav {
      display: none;
    }
    .top-docs {
      display: inline-flex;
    }
  }

  /* ---- Hero ---- */
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(4.5rem, 11vw, 9rem) clamp(4rem, 9vw, 7.5rem);
    overflow: hidden;
  }
  /* Engineering paper: a dot grid, fading out from the headline. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(color-mix(in oklab, var(--color-ink) 22%, transparent) 1px, transparent 1.2px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 75% 70% at 25% 30%, black 10%, transparent 72%);
    opacity: 0.55;
  }
  .hero::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: -12rem;
    right: -8rem;
    width: 44rem;
    height: 34rem;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--color-signal) 13%, transparent), transparent);
    filter: blur(10px);
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.3rem 0.8rem 0.3rem 0.65rem;
    border: 1px solid var(--color-hairline-strong);
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-surface) 80%, transparent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    transition: border-color 150ms ease-out;
  }
  .pill:hover {
    border-color: color-mix(in oklab, var(--color-signal) 60%, transparent);
  }
  .pill-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-signal);
    box-shadow: 0 0 0 3px var(--color-signal-soft);
  }
  .pill-muted {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding-left: 0.55rem;
    border-left: 1px solid var(--color-hairline-strong);
    color: var(--color-fd-muted-foreground);
  }
  h1 {
    max-width: 11.5em;
    margin: 1.75rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(3.1rem, 8.4vw, 7.25rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .hero-foot {
    display: grid;
    grid-template-columns: minmax(0, 34rem) auto;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    margin-top: clamp(2.25rem, 4vw, 3.25rem);
  }
  @media (max-width: 880px) {
    .hero-foot {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .lede {
    margin: 0;
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.55;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 3rem;
    padding: 0 1.35rem;
    border-radius: 999px;
    border: 1px solid var(--color-hairline-strong);
    background: color-mix(in oklab, var(--color-surface) 70%, transparent);
    font-size: 0.9375rem;
    font-weight: 550;
    transition: background-color 150ms ease-out, border-color 150ms ease-out;
  }
  .btn:hover {
    border-color: color-mix(in oklab, var(--color-ink) 35%, transparent);
  }
  .btn-primary {
    border-color: transparent;
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .btn-primary:hover {
    background: color-mix(in oklab, var(--color-ink) 86%, var(--color-signal));
  }
  /* Words rise into place, once. */
  .rise {
    animation: rise 700ms cubic-bezier(0.2, 0.75, 0.2, 1) both;
    animation-delay: calc(var(--i) * 55ms);
  }
  h1 .rise {
    display: inline-block;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.35em);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rise {
      animation: none;
    }
  }

  /* ---- Rust and Luau, side by side ---- */
  .pair,
  .bench,
  .docs,
  .features,
  .agents {
    padding-block: clamp(5rem, 10vw, 8rem);
    border-top: 1px solid var(--color-hairline);
  }
  .pair-head {
    margin-bottom: 3rem;
  }
  .pair-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }
  @media (max-width: 960px) {
    .pair-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .pair-item {
    margin: 0;
  }
  .pair-item :global(.cb) {
    margin: 0;
    border-radius: 1rem;
    box-shadow:
      0 1px 0 color-mix(in oklab, var(--color-ink) 4%, transparent),
      0 30px 60px -36px color-mix(in oklab, var(--color-ink) 30%, transparent);
  }
  .pair-item :global(.cb-pre) {
    padding-block: 1.15rem;
    font-size: 0.8125rem;
  }
  .pair-item figcaption {
    margin: 1.1rem 0.25rem 0;
    font-size: 0.9375rem;
