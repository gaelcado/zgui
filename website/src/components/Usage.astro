---
// A command's usage text, read from its source.
import { rustString } from '@/lib/repo';
import { codeBlock } from '@/lib/highlight';

interface Props {
  file: string;
  name: string;
}
const { file, name } = Astro.props;
// Astro reports a component's error inside MDX only as "error while rendering":
// say what it was.
let html: string;
try {
  html = codeBlock({ code: rustString(file, name), lang: 'text', title: `${file.split('/').pop()} · ${name}` });
} catch (error) {
  console.error(`Usage ${file} ${name}:`, error);
  throw error;
}
---

<Fragment set:html={html} />
