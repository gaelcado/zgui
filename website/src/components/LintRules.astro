---
import { lintRules } from '@/lib/repo';
let rules: ReturnType<typeof lintRules>;
try {
  rules = lintRules();
} catch (error) {
  console.error('LintRules:', error);
  throw error;
}
---

<table>
  <thead><tr><th scope="col">Rule</th><th scope="col">Flags</th></tr></thead>
  <tbody>
    {rules.map((r) => (
      <tr>
        <td><code>{r.name}</code></td>
        <td>{r.summary}</td>
      </tr>
    ))}
  </tbody>
</table>
