{
	"name": "vscode-light-plus",
	"type": "light",
	"extends": "zgx-light",
	"tokens": {
		"background": "#ffffff",
		"surface": {
			"sunken": "#ffffff",
			"base": "#f3f3f3",
			"raised": "#e8e8e8",
			"overlay": "#ffffff"
		},
		"text": {
			"primary": "#1f1f1f",
			"secondary": "#616161",
			"tertiary": "#767676",
			"disabled": "#1f1f1f61"
		},
		"border": "#0000001f",
		"border.subtle": "#00000012",
		"border.strong": "#00000038",
		"accent": "#0078d4",
		"accent.hover": "#2e90dc",
		"accent.text": "#000000",
		"danger": "#a1260d",
		"warning": "#895503",
		"success": "#008000",
		"info": "#795e26",
		"selection": "#0078d43d",
		"selection.item": "#1a1a1a0f",
		"focus.ring": "{border.strong}",
		"hover": "#0000000f",
		"pressed": "#0078d41a",
		"scrollbar": {
			"thumb": "#1f1f1f4c",
			"thumb.active": "#1f1f1f8c",
			"track": "#00000000"
		},
		"glass": {
			"tint": "#f3f3f3cc",
			"blur": 24
		},
		"font": {
			"sans": "Geist",
			"mono": "Geist Mono",
			"size": {
				"xs": 11,
				"sm": 12,
				"md": 13,
				"lg": 14,
				"xl": 16,
				"xxl": 19
			},
			"line": {
				"xs": 16,
				"sm": 16,
				"md": 18,
				"lg": 22,
				"xl": 24,
				"xxl": 27
			},
			"weight": {
				"regular": 400,
				"medium": 500,
				"semibold": 600,
				"bold": 700
			}
		},
		"radius": {
			"sm": 4,
			"md": 6,
			"lg": 10,
			"xl": 16,
			"full": 9999
		},
		"space": {
			"1": 4,
			"2": 8,
			"3": 12,
			"4": 16,
			"5": 24,
			"6": 32,
			"7": 48,
			"8": 64
		},
		"control.height": 32,
		"shadow": {
			"sm": "0 1 2 0 #00000029",
			"md": "0 4 12 0 #00000059",
			"lg": "0 16 40 0 #00000080"
		},
		"motion": {
			"duration": {
				"fast": 140,
				"normal": 180,
				"slow": 320
			},
			"ease": {
				"standard": "cubicBezier(0.2, 0, 0, 1)",
				"enter": "cubicBezier(0.16, 1, 0.3, 1)",
				"exit": "cubicBezier(0.25, 0.1, 0.25, 1)"
			}
		},
		"button.bg": "{surface.raised}",
		"button.hover": "alpha({text.primary}, 0.08)",
		"button.pressed": "alpha({text.primary}, 0.12)",
		"input.bg": "#ffffff",
		"menu.bg": "{surface.overlay}",
		"zeron": {
			"sidebar": "#ebebeb0d",
			"card": "#ffffff",
			"dialog": "#fefefe",
			"input.border": "#4352601a",
			"solid": "#232328",
			"on_solid": "#ffffff",
			"danger.muted": "#7d2412",
			"danger.strong": "#a1260d",
			"danger.text": "#ffffff",
			"danger.hover": "#94230c",
			"danger.pressed": "#87200b",
			"info.strong": "#795e26",
			"info.text": "#ffffff",
			"info.hover": "#6f5623",
			"info.pressed": "#664f20",
			"warning.strong": "#895503",
			"warning.text": "#ffffff",
			"warning.hover": "#7e4e03",
			"warning.pressed": "#734703",
			"success.strong": "#008000",
			"success.text": "#ffffff",
			"success.hover": "#007600",
			"success.pressed": "#006c00",
			"warning.muted": "#6e480a",
			"success.muted": "#086808",
			"accent": {
				"wash": "#0078d41f",
				"selection": "#0078d43d"
			},
			"ink": {
				"1": "#0000000a",
				"2": "#0000000f",
				"3": "#00000014",
				"4": "#0000001c",
				"5": "#00000029",
				"6": "#00000038"
			},
			"diff": {
				"add": "#008000",
				"delete": "#a1260d",
				"hunk": "#0078d412"
			},
			"cursor": "#1f1f1f8c",
			"scrim": "#00000099",
			"code.wash": "#0078d41f",
			"claude": "#d97757",
			"glass": {
				"active": "#0000001c",
				"hover": "#0000000d"
			},
			"radius": {
				"card": 12,
				"item": 7,
				"composer": 26,
				"button": 8
			},
			"control": {
				"sm": 26,
				"lg": 38
			},
			"font.size.micro": 10,
			"motion": {
				"hover": 150,
				"menu_in": 140,
				"menu_out": 100,
				"dialog_in": 180,
				"collapse": 180,
				"resize": 200,
				"glyph": 280,
				"resort": 260,
				"fade_in": 500,
				"tab_slide": 150,
				"scroll_glide": 500,
				"morph": 420,
				"roll": 550
			},
			"solid.hover": "#3d3d42",
			"solid.pressed": "#4f4f53",
			"terminal": {
				"fg": "#1f1f1f",
				"selection": "#d6d6d6",
				"ansi": {
					"0": "#1f1f1f",
					"1": "#dc2626",
					"2": "#16a34a",
					"3": "#b45309",
					"4": "#2563eb",
					"5": "#9333ea",
					"6": "#0e7490",
					"7": "#3f3f46",
					"8": "#71717a",
					"9": "#b91c1c",
					"10": "#15803d",
					"11": "#92400e",
					"12": "#1d4ed8",
					"13": "#7e22ce",
					"14": "#155e75",
					"15": "#18181b"
				}
			}
		}
	},
	"_source": {
		"family": "vscode-default",
		"name": "Light+",
		"treatment": "Opaque",
		"from": "comet crates/theme/src/builtins.rs"
	}
}
