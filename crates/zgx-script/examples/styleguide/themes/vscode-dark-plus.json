{
	"name": "vscode-dark-plus",
	"type": "dark",
	"extends": "zgx-dark",
	"tokens": {
		"background": "#1e1e1e",
		"surface": {
			"sunken": "#1e1e1e",
			"base": "#181818",
			"raised": "#2a2d2e",
			"overlay": "#272829"
		},
		"text": {
			"primary": "#d4d4d4",
			"secondary": "#a8a8a8",
			"tertiary": "#858585",
			"disabled": "#d4d4d461"
