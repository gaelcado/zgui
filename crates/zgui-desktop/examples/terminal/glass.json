{
	// Dark glass, as the browser example: the window's blur shows through the
	// tint, and foregrounds are translucent white so they take the colour of
	// what is behind the glass, as AppKit's vibrant labels do.
	"name": "terminal-glass",
	"type": "dark",
	"extends": "zgui-dark",
	"tokens": {
		"glass.tint": "#13141873",
		"text": {
			"primary": "#ffffffeb",
			"secondary": "#ffffffa6",
			"tertiary": "#ffffff66",
			"disabled": "#ffffff38"
		},
		"hover": "#ffffff0a",
		"border.subtle": "#ffffff0d",
		"border.strong": "#ffffff26",
		"accent": "#a99cff",
		"warning": "#f5c46b",
		"danger": "#ff7a6b",
		// The interface's typeface (the host registers it).
		"font.sans": "Geist",
		// Each terminal's card: a little darker than the window, still glass.
		"terminal.pane": "#0a0b0e4d",
		"terminal.wash": "#ffffff0f",
		// Frosted glass under the active tab and agent, clearer than the
		// wash; a faint one under the pointer.
		"terminal.glass": "#ffffff1c",
		"terminal.glass_hover": "#ffffff0d",
		// A tab's icon tiles, and the strip's drop and slot highlights.
		"terminal.tile_bg": "#ffffff17",
		"terminal.tile_dim": "#ffffff0d",
		"terminal.tile_line": "#ffffff0f",
		"terminal.drop": "#ffffff1f",
		"terminal.slot": "#ffffff0f",
		"terminal.slot_line": "#ffffff29",
		// Context menus: a darker frost than the window's.
		"terminal.menu.bg": "#24252a99",
		"terminal.menu.line": "#ffffff14",
		"terminal.menu.hover": "#ffffff12",
		"terminal.menu.separator": "#ffffff0f",
		"terminal.menu.shadow": "0 6 18 0 #00000040"
	}
}
