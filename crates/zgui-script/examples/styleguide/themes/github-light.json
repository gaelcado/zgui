			"dialog": "#fdfdfe",
			"input.border": "#4352601a",
			"solid": "#232328",
			"on_solid": "#ffffff",
			"danger.muted": "#9e222c",
			"danger.strong": "#cf222e",
			"danger.text": "#ffffff",
			"danger.hover": "#be1f2a",
			"danger.pressed": "#ae1d27",
			"info.strong": "#8250df",
			"info.text": "#ffffff",
			"info.hover": "#784acd",
			"info.pressed": "#6d43bb",
			"warning.strong": "#9a6700",
			"warning.text": "#ffffff",
			"warning.hover": "#8e5f00",
			"warning.pressed": "#815700",
			"success.strong": "#1a7f37",
			"success.text": "#ffffff",
			"success.hover": "#187533",
			"success.pressed": "#166b2e",
			"warning.muted": "#7b560a",
