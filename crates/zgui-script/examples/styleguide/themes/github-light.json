				"4": "#0000001c",
				"5": "#00000029",
				"6": "#00000038"
			},
			"diff": {
				"add": "#1a7f37",
				"delete": "#cf222e",
				"hunk": "#0969da12"
			},
			"cursor": "#1f23288c",
			"scrim": "#00000099",
			"code.wash": "#0969da1f",
			"claude": "#d97757",
			"glass": {
				"active": "#0000001c",
				"hover": "#0000000d"
			},
			"radius": {
				"card": 12,
				"item": 7,
				"composer": 26,
				"button": 8
			},
			"control": {
				"sm": 26,
				"lg": 38
			},
			"font.size.micro": 10,
			"motion": {
				"hover": 150,
				"menu_in": 140,
				"menu_out": 100,
				"dialog_in": 180,
				"collapse": 180,
				"resize": 200,
				"glyph": 280,
				"resort": 260,
				"fade_in": 500,
				"tab_slide": 150,
				"scroll_glide": 500,
				"morph": 420,
				"roll": 550
			},
			"solid.hover": "#3d3d42",
			"solid.pressed": "#4f4f53"
		}
	},
	"_source": {
		"family": "github",
		"name": "GitHub Light",
		"treatment": "Opaque",
		"from": "comet crates/theme/src/builtins.rs"
	}
}
