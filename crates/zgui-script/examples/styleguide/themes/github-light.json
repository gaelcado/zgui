{
	"name": "github-light",
	"type": "light",
	"extends": "zgui-light",
	"tokens": {
		"background": "#ffffff",
		"surface": {
			"sunken": "#ffffff",
			"base": "#f6f8fa",
			"raised": "#d0d7de",
			"overlay": "#fefefe"
		},
		"text": {
			"primary": "#1f2328",
			"secondary": "#656d76",
			"tertiary": "#818b98",
			"disabled": "#1f232861"
		},
		"border": "#0000001f",
		"border.subtle": "#00000012",
		"border.strong": "#00000038",
		"accent": "#0969da",
		"accent.hover": "#3584e1",
		"accent.text": "#ffffff",
		"danger": "#cf222e",
		"warning": "#9a6700",
		"success": "#1a7f37",
		"info": "#8250df",
		"selection": "#0969da3d",
		"selection.item": "#1a1a1a0f",
		"focus.ring": "{border.strong}",
		"hover": "#0000000f",
		"pressed": "#0969da1a",
		"scrollbar": {
			"thumb": "#1f23284c",
			"thumb.active": "#1f23288c",
			"track": "#00000000"
		},
		"glass": {
			"tint": "#f6f8facc",
			"blur": 24
		},
		"font": {
			"sans": "Geist",
			"mono": "Geist Mono",
			"size": {
				"xs": 11,
				"sm": 12,
				"md": 13,
				"lg": 14,
				"xl": 16,
				"xxl": 19
			},
			"line": {
				"xs": 16,
				"sm": 16,
				"md": 18,
				"lg": 22,
				"xl": 24,
				"xxl": 27
			},
			"weight": {
				"regular": 400,
				"medium": 500,
				"semibold": 600,
				"bold": 700
			}
		},
		"radius": {
			"sm": 4,
			"md": 6,
			"lg": 10,
			"xl": 16,
			"full": 9999
		},
		"space": {
			"1": 4,
			"2": 8,
			"3": 12,
			"4": 16,
			"5": 24,
			"6": 32,
			"7": 48,
			"8": 64
		},
		"control.height": 32,
		"shadow": {
			"sm": "0 1 2 0 #00000029",
			"md": "0 4 12 0 #00000059",
